#!/bin/sh
# Explicit graph-layout validation; never called by the portable updater.
set -eu
usage() {
    echo "Usage: cosmix-test-layout [built-entry.html]"
    echo "Default entry: COSMIX_TEST_PAGE, or ~/cosmix/web/index.html (existing installations also supported). See TESTING.md."
}
case "${1:-}" in
    --help|-h) usage; exit 0 ;;
    -*) usage >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ]; then usage >&2; exit 2; fi
default_page="$HOME/cosmix/web/index.html"
if [ ! -f "$default_page" ] && [ -f "$HOME/vme/web/index.html" ]; then
    default_page="$HOME/vme/web/index.html"
fi
entry=${1:-${COSMIX_TEST_PAGE:-${VME_TEST_PAGE:-$default_page}}}
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v node >/dev/null 2>&1; then
    echo "Node.js is required for CoSMiX validation; see TESTING.md." >&2
    exit 127
fi
exec node "$script_dir/../rank2_feature_graph/verify_graph_layout.mjs" "$entry"
