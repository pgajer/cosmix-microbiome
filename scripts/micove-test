#!/bin/sh
# Explicit developer validation; never called by the portable updater.
set -eu
usage() {
    echo "Usage: micove-test [--audit-layouts] [built-entry.html]"
    echo "Default entry: MICOVE_TEST_PAGE, or ~/micove/web/index.html (existing installations also supported). See TESTING.md."
}
audit=false
case "${1:-}" in
    --audit-layouts) audit=true; shift ;;
    --help|-h) usage; exit 0 ;;
esac
case "${1:-}" in
    --help|-h) usage; exit 0 ;;
    -*) usage >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ]; then usage >&2; exit 2; fi
default_page="$HOME/micove/web/index.html"
if [ ! -f "$default_page" ] && [ -f "$HOME/cosmix/web/index.html" ]; then
    default_page="$HOME/cosmix/web/index.html"
fi
if [ ! -f "$default_page" ] && [ -f "$HOME/vme/web/index.html" ]; then
    default_page="$HOME/vme/web/index.html"
fi
entry=${1:-${MICOVE_TEST_PAGE:-${COSMIX_TEST_PAGE:-${VME_TEST_PAGE:-$default_page}}}}
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v node >/dev/null 2>&1; then
    echo "Node.js is required for MiCOVE validation; see TESTING.md." >&2
    exit 127
fi
if [ "$audit" = true ]; then
    exec node "$script_dir/../rank2_feature_graph/verify_http_assets.mjs" "$entry" --audit-layouts
fi
exec node "$script_dir/../rank2_feature_graph/verify_http_assets.mjs" "$entry"
